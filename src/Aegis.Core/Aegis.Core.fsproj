<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <Description>Aegis core: fault model, redaction, capture and sink runtime. No third-party dependencies.</Description>
    <PackageId>EchelonFoundry.Aegis.Core</PackageId>
    <Version>1.0.0</Version>
    <PackageTags>fault-handling;error-handling;fsharp;observability;diagnostics;resilience</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Requirements: core 35, logging 42. The core takes no third-party
       dependency: no logging framework, no DI container, no telemetry or
       storage SDK. Storage adapters live outside this project. -->
  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="Redaction.fs" />
    <Compile Include="Provenance.fs" />
    <Compile Include="Serialization.fs" />
    <Compile Include="Lifecycle.fs" />
    <Compile Include="Offline.fs" />
    <Compile Include="Store.fs" />
    <Compile Include="Translation.fs" />
    <Compile Include="Recovery.fs" />
    <Compile Include="Escalation.fs" />
    <Compile Include="Presentation.fs" />
    <Compile Include="Diagnostics.fs" />
    <Compile Include="Catalog.fs" />
    <Compile Include="Containment.fs" />
    <Compile Include="Sde.fs" />
    <Compile Include="Sinks.fs" />
    <Compile Include="Health.fs" />
    <Compile Include="Capture.fs" />
    <Compile Include="Tutela.fs" />
    <Compile Include="Bootstrap.fs" />
  </ItemGroup>

</Project>
