<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <Description>GitHub storage adapter for Aegis. Repository operations are injected; this package contains no GitHub API client.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="GitHubStore.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Aegis.Core/Aegis.Core.fsproj" />
  </ItemGroup>

</Project>
